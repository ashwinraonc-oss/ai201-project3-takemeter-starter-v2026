# API keys — never commit these
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Hugging Face model cache — big, and rebuildable
.cache/
models/

# The notebook's training output directory. Checkpoints are hundreds of MB and
# they are not evidence of anything — results.json is. Without this line a
# `git add -A` in Colab commits a model checkpoint to your repo.
takemeter_out/

# OS noise
.DS_Store
Thumbs.db

# NOTE: results.json, results_three_seeds.json and baseline_results.json are
# deliberately NOT ignored. They're evidence the run actually happened, and
# they're part of what gets graded. Commit them.

# The staff answer key. Unlike everything above, this is NOT evidence to
# commit — it's a shared course answer key (the same 30 posts and labels
# other students get too), and it isn't in the "files to commit" list in
# RUNNING.md or the submission checklist. agreement_results.json (the
# comparison's output) is the thing that's graded; the answer key itself
# stays local.
data/staff_labels.csv
